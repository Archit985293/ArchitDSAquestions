#include <stdio.h>
#include <stdlib.h>

// Comparator for sorting
int cmp(const void* a, const void* b) {
    return (*(int*)a - *(int*)b);
}

// Check if we can place k cows with min distance d
int canPlace(int stalls[], int n, int k, int dist) {
    int count = 1;  // first cow placed
    int last = stalls[0];

    for (int i = 1; i < n; i++) {
        if (stalls[i] - last >= dist) {
            count++;
            last = stalls[i];
        }
        if (count >= k)
            return 1;
    }
    return 0;
}

// Main function
int aggressiveCows(int stalls[], int n, int k) {
    // Sort stalls
    qsort(stalls, n, sizeof(int), cmp);

    int low = 1;
    int high = stalls[n - 1] - stalls[0];
    int ans = 0;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (canPlace(stalls, n, k, mid)) {
            ans = mid;          // possible
            low = mid + 1;      // try bigger distance
        } else {
            high = mid - 1;     // reduce distance
        }
    }

    return ans;
}

int main() {
    int n, k;

    printf("Enter number of stalls: ");
    scanf("%d", &n);

    int stalls[n];

    printf("Enter stall positions:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &stalls[i]);
    }

    printf("Enter number of cows: ");
    scanf("%d", &k);

    int result = aggressiveCows(stalls, n, k);

    printf("Maximum minimum distance: %d\n", result);

    return 0;
}
