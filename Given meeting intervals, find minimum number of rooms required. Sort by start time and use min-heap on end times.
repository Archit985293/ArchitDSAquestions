#include <stdio.h>
#include <stdlib.h>

// Structure for interval
typedef struct {
    int start;
    int end;
} Interval;

// Comparator for sorting by start time
int cmp(const void* a, const void* b) {
    Interval* x = (Interval*)a;
    Interval* y = (Interval*)b;
    return x->start - y->start;
}

// Swap helper
void swap(int* a, int* b) {
    int t = *a;
    *a = *b;
    *b = t;
}

// Min-heapify up
void heapifyUp(int heap[], int i) {
    while (i > 0) {
        int parent = (i - 1) / 2;
        if (heap[parent] <= heap[i]) break;
        swap(&heap[parent], &heap[i]);
        i = parent;
    }
}

// Min-heapify down
void heapifyDown(int heap[], int size, int i) {
    while (1) {
        int smallest = i;
        int left = 2 * i + 1;
        int right = 2 * i + 2;

        if (left < size && heap[left] < heap[smallest])
            smallest = left;
        if (right < size && heap[right] < heap[smallest])
            smallest = right;

        if (smallest == i) break;

        swap(&heap[i], &heap[smallest]);
        i = smallest;
    }
}

// Function to find minimum meeting rooms
int minMeetingRooms(Interval intervals[], int n) {
    if (n == 0) return 0;

    // Step 1: Sort by start time
    qsort(intervals, n, sizeof(Interval), cmp);

    // Min heap for end times
    int* heap = (int*)malloc(n * sizeof(int));
    int heapSize = 0;

    // First meeting
    heap[heapSize++] = intervals[0].end;

    for (int i = 1; i < n; i++) {
        // If earliest meeting ends before current starts → reuse
        if (heap[0] <= intervals[i].start) {
            heap[0] = intervals[i].end;
            heapifyDown(heap, heapSize, 0);
        } else {
            // Need new room
            heap[heapSize] = intervals[i].end;
            heapifyUp(heap, heapSize);
            heapSize++;
        }
    }

    int result = heapSize;
    free(heap);
    return result;
}

int main() {
    int n;

    printf("Enter number of meetings: ");
    scanf("%d", &n);

    Interval intervals[n];

    printf("Enter start and end times:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d %d", &intervals[i].start, &intervals[i].end);
    }

    int result = minMeetingRooms(intervals, n);

    printf("Minimum number of meeting rooms required: %d\n", result);

    return 0;
}
