#include <stdio.h>
#include <limits.h>

#define INF 1000000000   // large value to represent infinity

void floydWarshall(int n, int graph[n][n]) {

    // Step 1: Copy graph into dist matrix
    int dist[n][n];

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (graph[i][j] == -1)
                dist[i][j] = INF;
            else
                dist[i][j] = graph[i][j];
        }
    }

    // Step 2: Main Floyd-Warshall logic
    for (int k = 0; k < n; k++) {
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {

                if (dist[i][k] != INF && dist[k][j] != INF &&
                    dist[i][k] + dist[k][j] < dist[i][j]) {

                    dist[i][j] = dist[i][k] + dist[k][j];
                }
            }
        }
    }

    // Step 3: Convert INF back to -1
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (dist[i][j] == INF)
                dist[i][j] = -1;
        }
    }

    // Step 4: Print result
    printf("Shortest distance matrix:\n");
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            printf("%d ", dist[i][j]);
        }
        printf("\n");
    }
}

int main() {

    int n = 4;

    int graph[4][4] = {
        {0,   5,  -1, 10},
        {-1,  0,   3, -1},
        {-1, -1,   0,  1},
        {-1, -1,  -1,  0}
    };

    floydWarshall(n, graph);

    return 0;
}
